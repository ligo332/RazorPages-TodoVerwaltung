@page
@model RazorPagesTodo.Pages.TodoModel
@using RazorPagesTodo.Models
@{
	ViewData["Title"] = "Todo Verwaltung";
}

@section Styles {
	<link rel="stylesheet" href="~/css/todo.css" />
}

<div class="text-center">
	<h1 class="display-4">Todo Verwaltung</h1>
</div>

<form method="post" >

    <div id="testgrid">

        <input id="erledigt-ausblenden-checkbox" type="checkbox" />
        <div id="erledigt-checkbox-label">Erledigte ausblenden?</div>

        <a asp-page="./NewTodo"
            id="neu-btn"
            class="button-link">
            Neu
        </a>

        <button type="submit"
            asp-page-handler="EditSelected"
            class="button-link"
            id="bearbeiten-btn">
            Bearbeiten
        </button>

        <button type="submit"
            asp-page-handler="DeleteSelected"
            class="button-link"
            id="löschen-btn"
            onclick="return confirm('Möchtest du die ausgewählten Todos wirklich löschen?');">
            Löschen
        </button>
    </div>

    <div asp-validation-summary="All" class="validation-text"></div>
    
    <table class="table">
        <thead>
            <tr>
                <th>Auswählen</th>
                <th>Titel</th>
                <th>Erstellt am</th>
                <th>Priorität</th>
                <th>Erledigt</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var todo in Model.TodoItems)
            {
                <tr class="todo-row" data-completed="@todo.IsCompleted.ToString().ToLowerInvariant()">
                    <td>
                        <input type="checkbox"
                               name="selectedTodoIds"
                               value="@todo.Id"
                               id="select-todo-@todo.Id" />
                    </td>

                    <td>
                        <label for="select-todo-@todo.Id">
                            @todo.Title
                        </label>
                    </td>

                    <td>@todo.CreatedAt</td>

                    <td>
                        <span class="priority priority-@todo.Priority">
                            @todo.Priority
                        </span>
                    </td>

                    <td>
                        <input type="checkbox"
                               checked="@todo.IsCompleted"
                               disabled />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</form>

@section Scripts {
    <script>
        const hideCompletedCheckbox = document.getElementById("erledigt-ausblenden-checkbox");
        const todoRows = document.querySelectorAll(".todo-row");

        hideCompletedCheckbox.addEventListener("change", function () {
            todoRows.forEach(function (row) {
                const isCompleted = row.dataset.completed === "true";

                if (hideCompletedCheckbox.checked && isCompleted) {
                    row.style.display = "none";
                } else {
                    row.style.display = "";
                }
            });
        });
    </script>
}