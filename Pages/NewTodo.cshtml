@page
@model RazorPagesTodo.Pages.TodoModel
@using RazorPagesTodo.Models
@{
	ViewData["Title"] = "Neues Todo";
}

<head>
    <link rel="stylesheet" href="~/css/todo.css" />
	<h1>Neues Todo hinzufügen</h1>
</head>

<body>
    <form method="post" asp-page-handler="Add">

        <div class="container">
            <label asp-for="Input.Title"
                class="container">
                Titel:
            </label>

            <input asp-for="Input.Title" />

            <span asp-validation-for="Input.Title"
                class="validation-text">
            </span>
        </div>

        <div class="container">
			<label asp-for="Input.Priority"
                class="container">
                Priorität:
            </label>

			<select asp-for="Input.Priority">
                <option value="">Bitte auswählen</option>
                <option value="Niedrig">Niedrig</option>
                <option value="Mittel">Mittel</option>
                <option value="Hoch">Hoch</option>
			</select>

            <span asp-validation-for="Input.Priority"
                class="validation-text">
            </span>
        </div>

        <div class="container">
            <label asp-for="Input.IsCompleted">
                <input asp-for="Input.IsCompleted" />
                Todo schon erledigt?
            </label>
        </div> 

        <div class="container">
            <button type="submit"
                class="button-link">
                Hinzufügen
            </button>

            <a asp-page="/Todo">Zurück</a>
        </div>
    </form>
</body>