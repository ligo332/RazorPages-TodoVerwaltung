@page
@model TodoModel
@using RazorPagesTodo.Models
@{
	ViewData["Title"] = "Neues Todo";
}

@section Styles {
	<link rel="stylesheet" href="~/css/todo.css" />
}

<div class="text-center">
	<h1 class="display-4">Neues Todo</h1>
</div>

<body>
    <form method="post" asp-page-handler="Add">
        <div class="container">
            <label asp-for="Input.Title" class="container">Titel des Todo:</label>
            <input asp-for="Input.Title" />
            <span asp-validation-for="Input.Title"></span>
        </div>

        <div class="container">
			<label asp-for="Input.Priority" class="container">Priorität auswählen:</label>
			<select asp-for="Input.Priority">
                <option value="Niedrig">Niedrig</option>
                <option value="Mittel">Mittel</option>
                <option value="Hoch">Hoch</option>
			</select>
        </div>

        <div class="container">
            <label for="isCompleted" class="container">
                Todo schon erledigt?
                <input type="checkbox" id="completed-checkbox-formular" name="isCompleted" />
            </label>
        </div>

        <button type="submit" class="button-link">Hinzufügen</button>
        <a asp-page="/Todo">Abbrechen</a>
    </form>
</body>